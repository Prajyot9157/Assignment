
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Student Classes | Udayagiri</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary: #F02B6D;
            --primary-light: #FF5A8D;
            --bg-color: #FDF5F7;
            --card-bg: #FFFFFF;
            --text-main: #1F2937;
            --text-muted: #6B7280;
            --border-color: #F3E1E8;
            --success: #10B981;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        /* --- TOP APP BAR --- */
        .app-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px;
            background: var(--bg-color);
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .menu-btn {
            background: none;
            border: none;
            font-size: 20px;
            color: var(--text-main);
            cursor: pointer;
        }

        .app-title {
            font-size: 18px;
            font-weight: 700;
            color: #2D3748;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .app-title i {
            color: var(--primary);
            font-size: 16px;
        }

        .user-avatar-sm {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: #FCE4EC;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }

        /* --- MAIN CONTENT AREA --- */
        .main-content {
            flex: 1;
            overflow-y: auto;
            padding: 0 16px 100px 16px; /* Padding bottom for bottom nav */
        }

        .view-section {
            display: none;
            animation: fadeIn 0.3s ease;
        }
        .view-section.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* --- HOME DASHBOARD --- */
        .welcome-card {
            background: var(--card-bg);
            border-radius: 24px;
            padding: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 20px rgba(240, 43, 109, 0.05);
            border: 1px solid var(--border-color);
            margin-bottom: 24px;
        }

        .welcome-text h2 {
            font-size: 20px;
            font-weight: 700;
            color: #1a202c;
            margin-bottom: 4px;
        }
        .welcome-text p {
            font-size: 12px;
            color: var(--text-muted);
        }

        .user-avatar-lg {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            background-color: #FCE4EC;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 20px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }
        .section-header h3 {
            font-size: 16px;
            font-weight: 700;
            color: #2D3748;
        }
        .live-sync-badge {
            background: #FCE4EC;
            color: var(--primary);
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .live-sync-badge::before {
            content: '';
            width: 6px;
            height: 6px;
            background: var(--primary);
            border-radius: 50%;
            display: inline-block;
        }

        /* Live Event Cards */
        .event-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 16px;
            display: flex;
            gap: 16px;
            border: 1px solid var(--border-color);
            margin-bottom: 12px;
            position: relative;
        }
        
        .event-icon {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }
        
        .event-details {
            flex: 1;
        }
        .event-details h4 {
            font-size: 14px;
            font-weight: 700;
            color: #1F2937;
            margin-bottom: 4px;
            line-height: 1.3;
        }
        .event-details p {
            font-size: 12px;
            color: var(--text-muted);
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .event-meta {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            justify-content: space-between;
            flex-shrink: 0;
        }
        
        .date-badge {
            background: #FCE4EC;
            color: var(--primary);
            padding: 4px 8px;
            border-radius: 8px;
            font-size: 10px;
            font-weight: 700;
        }
        .status-badge {
            font-size: 10px;
            font-weight: 700;
            color: var(--success);
        }

        /* Folder Cards */
        .folder-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 16px;
            border: 1px solid var(--border-color);
            margin-bottom: 12px;
            cursor: pointer;
        }
        .folder-icon {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            background: #FCE4EC;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }
        .folder-details {
            flex: 1;
        }
        .folder-details h4 { font-size: 14px; font-weight: 700; color: #1F2937; }
        .folder-details p { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
        .folder-arrow { color: #D1D5DB; }

        /* --- PROFILE VIEW --- */
        .profile-banner {
            background: linear-gradient(135deg, #F02B6D, #FF5A8D);
            border-radius: 24px;
            padding: 24px;
            color: white;
            margin-bottom: 20px;
            box-shadow: 0 8px 24px rgba(240, 43, 109, 0.2);
        }
        .profile-banner h2 { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
        .profile-banner p { font-size: 12px; opacity: 0.9; line-height: 1.4; }

        .profile-form-card {
            background: var(--card-bg);
            border-radius: 24px;
            padding: 32px 24px;
            border: 1px solid var(--border-color);
            text-align: center;
            box-shadow: 0 4px 24px rgba(0,0,0,0.03);
        }

        .profile-avatar-xl {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background-color: #FCE4EC;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 28px;
            margin: 0 auto 16px auto;
        }
        
        .profile-name-title { font-size: 20px; font-weight: 700; color: #1F2937; margin-bottom: 4px; }
        .profile-uid { font-size: 11px; color: var(--text-muted); margin-bottom: 32px; font-weight: 500;}

        .input-group {
            position: relative;
            margin-bottom: 20px;
            text-align: left;
        }
        .input-group fieldset {
            border: 1px solid #9CA3AF;
            border-radius: 12px;
            padding: 0 16px;
            display: flex;
            align-items: center;
            height: 56px;
            transition: all 0.2s ease;
        }
        .input-group fieldset:focus-within {
            border-color: var(--primary);
            border-width: 2px;
        }
        .input-group legend {
            font-size: 11px;
            color: #6B7280;
            padding: 0 4px;
            font-weight: 600;
            margin-left: 8px;
        }
        .input-group i {
            color: var(--primary);
            font-size: 18px;
            margin-right: 12px;
        }
        .input-group input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 15px;
            font-weight: 600;
            color: #1F2937;
            background: transparent;
        }
        .input-group input:read-only { color: #6B7280; }

        .btn-primary {
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 14px;
            padding: 16px;
            width: 100%;
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            margin-top: 10px;
            transition: transform 0.1s;
        }
        .btn-primary:active { transform: scale(0.98); }

        /* --- SUBJECT/MATERIAL LISTS --- */
        .subject-group {
            margin-bottom: 24px;
        }
        .subject-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 8px;
        }
        .doc-item {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 10px;
            border: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .doc-info h4 { font-size: 13px; color: #1F2937; margin-bottom: 4px; }
        .doc-info p { font-size: 11px; color: var(--text-muted); }
        .btn-open {
            background: #FCE4EC;
            color: var(--primary);
            padding: 6px 12px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 11px;
            font-weight: 700;
        }
        .empty-state {
            text-align: center;
            padding: 20px;
            color: var(--text-muted);
            font-size: 12px;
            background: white;
            border-radius: 16px;
            border: 1px dashed #d1d5db;
        }

        /* --- BOTTOM NAVIGATION --- */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: var(--card-bg);
            display: flex;
            justify-content: space-around;
            padding: 12px 10px;
            box-shadow: 0 -4px 20px rgba(0,0,0,0.05);
            z-index: 40;
            padding-bottom: env(safe-area-inset-bottom, 12px);
        }
        
        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            color: #9CA3AF;
            text-decoration: none;
            font-size: 10px;
            font-weight: 600;
            width: 60px;
            cursor: pointer;
        }
        
        .nav-icon {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            border-radius: 12px;
            transition: all 0.2s;
        }
        
        .nav-item.active {
            color: var(--primary);
        }
        .nav-item.active .nav-icon {
            background: #FCE4EC;
            color: var(--primary);
        }

        /* --- SIDEBAR DRAWER --- */
        .drawer-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.4);
            z-index: 100;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
        .drawer-overlay.open {
            opacity: 1;
            pointer-events: auto;
        }

        .drawer {
            position: fixed;
            top: 0;
            left: -320px;
            width: 280px;
            height: 100%;
            background: white;
            z-index: 101;
            transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            box-shadow: 4px 0 24px rgba(0,0,0,0.1);
            border-radius: 0 24px 24px 0;
        }
        .drawer.open {
            left: 0;
        }
        
        .drawer-header {
            background: linear-gradient(135deg, #F02B6D, #FF5A8D);
            padding: 40px 24px 24px 24px;
            color: white;
            border-radius: 0 24px 0 0;
        }
        .drawer-avatar {
            width: 56px;
            height: 56px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: var(--primary);
            margin-bottom: 12px;
        }
        .drawer-name { font-size: 18px; font-weight: 700; margin-bottom: 2px;}
        .drawer-email { font-size: 12px; opacity: 0.9; }

        .drawer-menu {
            padding: 24px 16px;
            flex: 1;
            overflow-y: auto;
        }
        .drawer-menu a {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 14px 16px;
            color: #4B5563;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            border-radius: 16px;
            margin-bottom: 8px;
            transition: background 0.2s;
        }
        .drawer-menu a i { font-size: 18px; width: 24px; text-align: center; }
        .drawer-menu a.active {
            background: #FCE4EC;
            color: var(--primary);
        }
        .drawer-logout {
            margin-top: auto;
            color: #EF4444 !important;
        }

        /* Loading Spinner */
        .loader {
            text-align: center;
            padding: 40px;
            color: var(--primary);
        }
        .toast {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: #333;
            color: white;
            padding: 12px 24px;
            border-radius: 24px;
            font-size: 12px;
            font-weight: 600;
            z-index: 1000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s;
        }
        .toast.show { opacity: 1; }
    </style>
</head>
<body>

    <!-- Top App Bar -->
    <header class="app-bar">
        <button class="menu-btn" id="menuBtn"><i class="fas fa-bars"></i></button>
        <div class="app-title">
            <i class="fa-solid fa-sparkles"></i> Student Classes
        </div>
        <div class="user-avatar-sm avatar-display">ST</div>
    </header>

    <!-- Sidebar Drawer -->
    <div class="drawer-overlay" id="drawerOverlay"></div>
    <div class="drawer" id="drawer">
        <div class="drawer-header">
            <div class="drawer-avatar"><i class="fas fa-graduation-cap"></i></div>
            <div class="drawer-name name-display">Student</div>
            <div class="drawer-email email-display">Loading...</div>
        </div>
        <div class="drawer-menu">
            <a href="#" class="nav-link active" data-target="home"><i class="fas fa-home"></i> Dashboard Home</a>
            <a href="#" class="nav-link" data-target="materials"><i class="fas fa-book-open"></i> Study Materials</a>
            <a href="#" class="nav-link" data-target="assignments"><i class="fas fa-clipboard-list"></i> Assignments Desk</a>
            <a href="#" onclick="showToast('Feature coming soon!')"><i class="far fa-calendar-check"></i> Attendance Report</a>
            <a href="#" onclick="showToast('Feature coming soon!')"><i class="far fa-credit-card"></i> Fees Status</a>
            <a href="#" class="nav-link" data-target="profile"><i class="fas fa-user"></i> My Profile</a>
            <div style="height: 20px;"></div>
            <a href="#" class="drawer-logout" onclick="showToast('Logged out securely')"><i class="fas fa-sign-out-alt"></i> Log Out Session</a>
        </div>
    </div>

    <!-- Main Content Area -->
    <main class="main-content">
        
        <!-- ================= HOME VIEW ================= -->
        <section id="view-home" class="view-section active">
            
            <div class="welcome-card">
                <div class="welcome-text">
                    <h2>Lovely Day, <span class="name-display" style="color:var(--primary)">Student</span></h2>
                    <p>Let's check details of your studies today.</p>
                </div>
                <div class="user-avatar-lg avatar-display">ST</div>
            </div>

            <div class="section-header">
                <h3>Live Ticker & Schedules</h3>
                <div class="live-sync-badge">LIVE SYNC</div>
            </div>
            
            <div id="liveEventsContainer">
                <div class="loader"><i class="fas fa-spinner fa-spin fa-2x"></i></div>
            </div>

            <div class="section-header" style="margin-top: 24px;">
                <h3>My Dashboard Folders</h3>
            </div>
            
            <div class="folder-card nav-link" data-target="materials">
                <div class="folder-icon" style="background:#FCE4EC; color:#F02B6D;"><i class="fas fa-book-reader"></i></div>
                <div class="folder-details">
                    <h4>Study Materials Library</h4>
                    <p id="materialsCountDisplay">0 files available</p>
                </div>
                <i class="fas fa-chevron-right folder-arrow"></i>
            </div>

            <div class="folder-card nav-link" data-target="assignments">
                <div class="folder-icon" style="background:#F3E8FF; color:#A855F7;"><i class="fas fa-clipboard-list"></i></div>
                <div class="folder-details">
                    <h4>My Assignments Task</h4>
                    <p id="assignmentsCountDisplay">0 topics assigned</p>
                </div>
                <i class="fas fa-chevron-right folder-arrow"></i>
            </div>
        </section>


        <!-- ================= MATERIALS VIEW ================= -->
        <section id="view-materials" class="view-section">
            <div class="section-header" style="margin-top: 10px;">
                <h3>Study Materials</h3>
            </div>
            <div id="materialsContainer">
                <div class="loader"><i class="fas fa-spinner fa-spin fa-2x"></i></div>
            </div>
        </section>


        <!-- ================= ASSIGNMENTS VIEW ================= -->
        <section id="view-assignments" class="view-section">
            <div class="section-header" style="margin-top: 10px;">
                <h3>Assignments Desk</h3>
            </div>
            <div id="assignmentsContainer">
                <div class="loader"><i class="fas fa-spinner fa-spin fa-2x"></i></div>
            </div>
        </section>


        <!-- ================= PROFILE VIEW ================= -->
        <section id="view-profile" class="view-section">
            <div class="profile-banner">
                <h2>My Profile Badge</h2>
                <p>Manage personal, display, and telephone info synced with Firestore.</p>
            </div>

            <div class="profile-form-card">
                <div class="profile-avatar-xl avatar-display">ST</div>
                <h3 class="profile-name-title name-display">Student</h3>
                <p class="profile-uid" id="uidDisplay">Permanent Academic UID: Loading...</p>

                <div class="input-group">
                    <fieldset>
                        <legend>Display Full Name</legend>
                        <i class="fas fa-user"></i>
                        <input type="text" id="profileName" value="Student">
                    </fieldset>
                </div>

                <div class="input-group">
                    <fieldset>
                        <legend>Telephone Contact</legend>
                        <i class="fas fa-phone-alt"></i>
                        <input type="tel" id="profilePhone" placeholder="Enter Phone Number">
                    </fieldset>
                </div>

                <div class="input-group">
                    <fieldset>
                        <legend>Academic Logins Email (Immutable)</legend>
                        <i class="fas fa-envelope"></i>
                        <input type="email" id="profileEmail" value="student@udayagiri.com" readonly>
                    </fieldset>
                </div>

                <button class="btn-primary" id="saveProfileBtn">
                    <i class="fas fa-save"></i> Commit Changes in Profile
                </button>
            </div>
        </section>

    </main>

    <!-- Bottom Navigation -->
    <nav class="bottom-nav">
        <a href="#" class="nav-item nav-link active" data-target="home">
            <div class="nav-icon"><i class="fas fa-home"></i></div>
            <span>Home</span>
        </a>
        <a href="#" class="nav-item nav-link" data-target="materials">
            <div class="nav-icon"><i class="fas fa-book-open"></i></div>
            <span>Materials</span>
        </a>
        <a href="#" class="nav-item nav-link" data-target="assignments">
            <div class="nav-icon"><i class="fas fa-clipboard-list"></i></div>
            <span>Assignments</span>
        </a>
        <a href="#" class="nav-item nav-link" data-target="profile">
            <div class="nav-icon"><i class="fas fa-user"></i></div>
            <span>Profile</span>
        </a>
    </nav>

    <div id="toast" class="toast">Notification</div>

    <!-- Firebase SDK (v11.6.1 Modular) -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, onSnapshot, doc, getDoc, setDoc, query, orderBy } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Firebase Configuration (Matching Admin Panel)
        const firebaseConfig = {
            apiKey: "AIzaSyBPtxG_tTq33ltQSo2oiJjrEQIaIGOEAwc",
            authDomain: "udayagiri-f3a6d.firebaseapp.com",
            projectId: "udayagiri-f3a6d",
            storageBucket: "udayagiri-f3a6d.firebasestorage.app",
            messagingSenderId: "912069472765",
            appId: "1:912069472765:web:dba14daa231e2addbf2994"
        };

        // Initialize Firebase
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        let currentUser = null;
        let materialsCount = 0;
        let assignmentsCount = 0;

        // UI Utility Functions
        window.showToast = function(msg) {
            const t = document.getElementById('toast');
            t.innerText = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 3000);
        }

        function escapeHtml(str) { 
            if(!str) return ''; 
            return String(str).replace(/[&<>]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[m])); 
        }

        function getInitials(name) {
            if(!name) return "ST";
            return name.substring(0, 2).toUpperCase();
        }

        function updateUIProfileInfo(data, uid) {
            const name = data.name || 'Student';
            const initials = getInitials(name);
            const email = data.email || 'student@udayagiri.com';
            
            // Update all displays
            document.querySelectorAll('.name-display').forEach(el => el.innerText = name);
            document.querySelectorAll('.avatar-display').forEach(el => el.innerText = initials);
            document.querySelectorAll('.email-display').forEach(el => el.innerText = email);
            
            // Update Profile Form
            document.getElementById('profileName').value = name;
            document.getElementById('profilePhone').value = data.phone || '';
            document.getElementById('profileEmail').value = email;
            document.getElementById('uidDisplay').innerText = `Permanent Academic UID: ${uid}`;
        }

        // Setup Realtime Listeners for Dashboard
        function setupDataListeners() {
            if (!currentUser) return;

            // 1. Live Events
            const liveRef = collection(db, "liveEvents");
            onSnapshot(liveRef, (snapshot) => {
                let events = [];
                snapshot.forEach(doc => events.push({id: doc.id, ...doc.data()}));
                // Sort Descending by Date
                events.sort((a,b) => new Date(b.date || 0) - new Date(a.date || 0));
                renderLiveEvents(events);
            }, (error) => {
                console.error("Error fetching live events:", error);
                document.getElementById('liveEventsContainer').innerHTML = '<div class="empty-state">Error loading schedule</div>';
            });

            // 2. Study Materials
            const materialsRef = collection(db, "studyMaterials");
            onSnapshot(materialsRef, (snapshot) => {
                let mats = [];
                snapshot.forEach(doc => mats.push({id: doc.id, ...doc.data()}));
                materialsCount = mats.length;
                document.getElementById('materialsCountDisplay').innerText = `${materialsCount} files available`;
                renderGroupedData(mats, 'materialsContainer', 'url', 'Open Material', 'fas fa-file-pdf');
            });

            // 3. Assignments
            const assignmentsRef = collection(db, "assignments");
            onSnapshot(assignmentsRef, (snapshot) => {
                let assigns = [];
                snapshot.forEach(doc => assigns.push({id: doc.id, ...doc.data()}));
                assignmentsCount = assigns.length;
                document.getElementById('assignmentsCountDisplay').innerText = `${assignmentsCount} topics assigned`;
                renderGroupedData(assigns, 'assignmentsContainer', null, null, 'fas fa-tasks');
            });
        }

        // Render Live Events in Home Tab
        function renderLiveEvents(events) {
            const container = document.getElementById('liveEventsContainer');
            if (events.length === 0) {
                container.innerHTML = `<div class="empty-state">No live classes scheduled for today.</div>`;
                return;
            }

            // Design palettes for icons
            const palettes = [
                { bg: '#FFE4E6', color: '#F43F5E', icon: 'fa-calendar-alt' }, // Pink
                { bg: '#FEF3C7', color: '#D97706', icon: 'fa-bullhorn' },     // Orange
                { bg: '#F3E8FF', color: '#A855F7', icon: 'fa-question-circle'}// Purple
            ];

            let html = '';
            events.forEach((ev, index) => {
                const p = palettes[index % palettes.length];
                html += `
                <div class="event-card">
                    <div class="event-icon" style="background: ${p.bg}; color: ${p.color};">
                        <i class="far ${p.icon}"></i>
                    </div>
                    <div class="event-details">
                        <h4>${escapeHtml(ev.title)}</h4>
                        <p>${escapeHtml(ev.description || 'No description provided.')}</p>
                    </div>
                    <div class="event-meta">
                        <span class="date-badge">${escapeHtml(ev.date || 'TBA')}</span>
                        <span class="status-badge">${escapeHtml(ev.status || 'Active')}</span>
                    </div>
                </div>`;
            });
            container.innerHTML = html;
        }

        // Render Subjects Grouped (For Materials & Assignments)
        function renderGroupedData(data, containerId, linkKey, linkText, defaultIcon) {
            const container = document.getElementById(containerId);
            if(data.length === 0) {
                container.innerHTML = `<div class="empty-state">No items found.</div>`;
                return;
            }

            // Group by subject
            const grouped = {};
            const subjects = ['Physics', 'Chemistry', 'Mathematics', 'Biology', 'English', 'Computer Science', 'Other'];
            
            data.forEach(item => {
                let sub = item.subject || 'Other';
                if(!subjects.includes(sub)) sub = 'Other';
                if(!grouped[sub]) grouped[sub] = [];
                grouped[sub].push(item);
            });

            let html = '';
            subjects.forEach(sub => {
                if(grouped[sub] && grouped[sub].length > 0) {
                    html += `
                    <div class="subject-group">
                        <div class="subject-title">
                            <i class="${defaultIcon}"></i> ${escapeHtml(sub)}
                        </div>`;
                    
                    grouped[sub].forEach(item => {
                        let actionBtn = '';
                        if(linkKey && item[linkKey]) {
                            actionBtn = `<a href="${escapeHtml(item[linkKey])}" target="_blank" class="btn-open">Open</a>`;
                        } else {
                            actionBtn = `<span class="date-badge" style="background:#F3F4F6; color:#6B7280;">Due: ${escapeHtml(item.dueDate || 'N/A')}</span>`;
                        }

                        html += `
                        <div class="doc-item">
                            <div class="doc-info">
                                <h4>${escapeHtml(item.title)}</h4>
                                <p>Date: ${escapeHtml(item.date || item.dueDate || 'Recently updated')}</p>
                            </div>
                            <div>${actionBtn}</div>
                        </div>`;
                    });
                    html += `</div>`;
                }
            });

            container.innerHTML = html;
        }

        // Authentication & Init
        const initAuth = async () => {
            onAuthStateChanged(auth, async (user) => {
                if (user) {
                    currentUser = user;
                    // Load Profile
                    const userRef = doc(db, 'users', user.uid);
                    try {
                        const userSnap = await getDoc(userRef);
                        if (userSnap.exists()) {
                            updateUIProfileInfo(userSnap.data(), user.uid);
                        } else {
                            // First time anon user
                            const initialData = { name: 'Student', email: 'student@udayagiri.com', phone: '' };
                            await setDoc(userRef, initialData);
                            updateUIProfileInfo(initialData, user.uid);
                        }
                    } catch(e) {
                        console.error("Error fetching user", e);
                    }
                    
                    setupDataListeners();
                }
            });

            // Always Sign in anonymously for this app demo if not logged in
            if(!auth.currentUser) {
                try {
                    await signInAnonymously(auth);
                } catch(e) {
                    console.error("Auth Error", e);
                    showToast("Authentication Failed");
                }
            }
        };

        // UI Interactions setup
        function setupNavigation() {
            const navLinks = document.querySelectorAll('.nav-link');
            const sections = document.querySelectorAll('.view-section');
            const bottomNavItems = document.querySelectorAll('.bottom-nav .nav-item');
            const drawerLinks = document.querySelectorAll('.drawer-menu .nav-link');
            
            const drawer = document.getElementById('drawer');
            const overlay = document.getElementById('drawerOverlay');
            
            // Drawer toggle
            document.getElementById('menuBtn').addEventListener('click', () => {
                drawer.classList.add('open');
                overlay.classList.add('open');
            });
            overlay.addEventListener('click', () => {
                drawer.classList.remove('open');
                overlay.classList.remove('open');
            });

            // View switching
            navLinks.forEach(link => {
                link.addEventListener('click', (e) => {
                    const target = link.getAttribute('data-target');
                    if(!target) return;
                    e.preventDefault();

                    // Hide all sections
                    sections.forEach(s => s.classList.remove('active'));
                    // Show target
                    document.getElementById(`view-${target}`).classList.add('active');

                    // Update bottom nav UI
                    bottomNavItems.forEach(item => {
                        item.classList.remove('active');
                        if(item.getAttribute('data-target') === target) item.classList.add('active');
                    });

                    // Update drawer UI
                    drawerLinks.forEach(item => {
                        item.classList.remove('active');
                        if(item.getAttribute('data-target') === target) item.classList.add('active');
                    });

                    // Close drawer if open
                    drawer.classList.remove('open');
                    overlay.classList.remove('open');
                    
                    // Scroll to top
                    document.querySelector('.main-content').scrollTop = 0;
                });
            });
        }

        // Save Profile Logic
        document.getElementById('saveProfileBtn').addEventListener('click', async () => {
            if(!currentUser) return;
            
            const name = document.getElementById('profileName').value.trim();
            const phone = document.getElementById('profilePhone').value.trim();
            
            if(!name) {
                showToast("Name cannot be empty");
                return;
            }

            const btn = document.getElementById('saveProfileBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
            btn.disabled = true;

            try {
                const userRef = doc(db, 'users', currentUser.uid);
                await setDoc(userRef, { name, phone }, { merge: true });
                
                // Update local UI
                updateUIProfileInfo({ name, phone, email: 'student@udayagiri.com' }, currentUser.uid);
                showToast("Profile Updated Successfully!");
            } catch (error) {
                console.error("Error saving profile", error);
                showToast("Error updating profile.");
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        });

        // Initialize App
        window.addEventListener('DOMContentLoaded', () => {
            setupNavigation();
            initAuth();
        });

    </script>
</body>
</html>


