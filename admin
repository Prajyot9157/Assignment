<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>MHT CET | Professional Control Panel</title>
    
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        appBg: '#090a10',
                        appCard: '#15161e',
                        appCardHover: '#1c1d26',
                        appPink: '#f43f5e',
                        appPinkDark: '#e11d48',
                        textMuted: '#8b8d9c'
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>

    <style>
        body { 
            background-color: #090a10; 
            color: #fff; 
            margin: 0; 
            padding: 0; 
            height: 100dvh; 
            display: flex; 
            flex-direction: column; 
            overflow: hidden; 
            -webkit-tap-highlight-color: transparent; 
        }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        .fade-in { animation: fadeIn 0.25s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
        
        .admin-input { 
            width: 100%; 
            background: #1a1b26; 
            border: 1px solid #2d2e3d; 
            border-radius: 0.75rem; 
            padding: 0.875rem; 
            color: white; 
            font-size: 0.875rem; 
            outline: none; 
            transition: all 0.2s; 
        }
        .admin-input:focus { 
            border-color: #f43f5e; 
            box-shadow: 0 0 0 2px rgba(244, 63, 94, 0.2); 
        }
        select.admin-input { 
            appearance: none; 
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%238b8d9c' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e"); 
            background-repeat: no-repeat; 
            background-position: right 1rem center; 
            background-size: 1em; 
        }
    </style>
</head>
<body>

    <!-- Professional Admin Header -->
    <header class="p-5 flex flex-col sm:flex-row gap-4 justify-between items-start sm:items-center bg-appCard border-b border-gray-800 shrink-0">
        <div class="flex items-center gap-4">
            <!-- Circular Admin Logo -->
            <img src="https://res.cloudinary.com/dygxni81n/image/upload/v1781399677/file_0000000016d0720b90d59b1433db483e_hhq2p2.png" alt="Admin Logo" class="w-12 h-12 rounded-full border-2 border-appPink shadow-lg object-cover">
            
            <div>
                <h1 class="text-xl font-bold leading-none text-white tracking-wide">Control Center</h1>
                <p class="text-xs text-appPink mt-1 font-medium">Manage Zoom Meetings, YouTube & PDFs</p>
            </div>
        </div>
        <div class="flex gap-2 w-full sm:w-auto">
            <button onclick="openUploadModal()" class="flex-1 sm:flex-none px-5 py-3 bg-appPink hover:bg-appPinkDark text-white text-sm font-bold rounded-xl shadow-md shadow-appPink/20 flex items-center justify-center gap-2 transition-all">
                <i class="fa-solid fa-plus"></i> Add New Material
            </button>
        </div>
    </header>

    <!-- Stat Dashboard Section -->
    <section class="px-5 pt-4 grid grid-cols-2 md:grid-cols-4 gap-3 shrink-0">
        <div class="bg-appCard border border-gray-800/80 p-3.5 rounded-2xl">
            <p class="text-[10px] uppercase font-bold text-textMuted tracking-wider">Total Items</p>
            <h3 class="text-2xl font-black text-white mt-1" id="stat-total">0</h3>
        </div>
        <div class="bg-appCard border border-gray-800/80 p-3.5 rounded-2xl">
            <p class="text-[10px] uppercase font-bold text-textMuted tracking-wider">Zoom Meetings</p>
            <h3 class="text-2xl font-black text-blue-400 mt-1" id="stat-zoom">0</h3>
        </div>
        <div class="bg-appCard border border-gray-800/80 p-3.5 rounded-2xl">
            <p class="text-[10px] uppercase font-bold text-textMuted tracking-wider">YouTube Videos</p>
            <h3 class="text-2xl font-black text-red-500 mt-1" id="stat-youtube">0</h3>
        </div>
        <div class="bg-appCard border border-gray-800/80 p-3.5 rounded-2xl">
            <p class="text-[10px] uppercase font-bold text-textMuted tracking-wider">Active PDFs</p>
            <h3 class="text-2xl font-black text-sky-400 mt-1" id="stat-pdf">0</h3>
        </div>
    </section>

    <!-- Filters and Live Search Controls -->
    <section class="p-5 pb-2 flex flex-col md:flex-row gap-3 shrink-0">
        <div class="flex-1 relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-textMuted">
                <i class="fa-solid fa-magnifying-glass text-sm"></i>
            </span>
            <input type="text" id="admin-search" oninput="filterAndSearchData()" placeholder="Search topics, papers or links..." class="w-full bg-appCard border border-gray-800 rounded-xl py-3 pl-10 pr-4 text-sm text-white outline-none focus:border-appPink transition-all">
        </div>
        <div class="flex gap-2">
            <select id="filter-type" onchange="filterAndSearchData()" class="bg-appCard border border-gray-800 text-white text-sm rounded-xl px-4 py-3 outline-none focus:border-appPink cursor-pointer">
                <option value="all">All Material Types</option>
                <option value="pdf">PDF Documents</option>
                <option value="youtube">YouTube Videos</option>
                <option value="zoom">Zoom Streams</option>
            </select>
            <select id="filter-category" onchange="filterAndSearchData()" class="bg-appCard border border-gray-800 text-white text-sm rounded-xl px-4 py-3 outline-none focus:border-appPink cursor-pointer">
                <option value="all">All Categories</option>
                <option value="notes">Notes</option>
                <option value="live">Live Classes</option>
                <option value="tests">Mock Tests</option>
                <option value="pyq">PYQ Bank</option>
                <option value="practice">Practice Sets</option>
                <option value="formula">Formula Sheets</option>
                <option value="mindmaps">Mind Maps</option>
                <option value="dpps">DPPs</option>
            </select>
        </div>
    </section>

    <!-- List Container -->
    <main class="flex-1 overflow-y-auto hide-scrollbar px-5 pb-6 space-y-3" id="admin-list">
        <div class="text-center py-12 text-textMuted">
            <i class="fa-solid fa-spinner fa-spin text-3xl mb-3 text-appPink"></i>
            <p class="text-sm">Retrieving active repository...</p>
        </div>
    </main>

    <!-- Upload/Edit Modal -->
    <div id="modal-upload" class="hidden absolute inset-0 z-50 flex items-end sm:items-center justify-center bg-black/80 backdrop-blur-sm transition-opacity p-2 sm:p-0">
        <div class="bg-appCard w-full sm:max-w-md sm:rounded-3xl rounded-3xl p-6 shadow-2xl border border-gray-800 fade-in max-h-[95dvh] overflow-y-auto hide-scrollbar">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-lg font-bold text-white" id="modal-title">Upload Asset</h3>
                <button onclick="closeUploadModal()" class="text-textMuted hover:text-white w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center"><i class="fa-solid fa-xmark"></i></button>
            </div>
            
            <form id="upload-form" onsubmit="handleUpload(event)" class="space-y-4">
                <input type="hidden" id="edit-id" value="">
                
                <div>
                    <label class="block text-xs text-textMuted mb-1 ml-1">Asset Placement Category</label>
                    <select id="up-category" class="admin-input" required>
                        <option value="notes">Notes</option>
                        <option value="live">Live Classes</option>
                        <option value="tests">Mock Tests</option>
                        <option value="pyq">PYQ Bank</option>
                        <option value="practice">Practice Sets</option>
                        <option value="formula">Formula Sheet</option>
                        <option value="mindmaps">Mind Maps</option>
                        <option value="dpps">DPPs</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs text-textMuted mb-1 ml-1">Academic Subject</label>
                    <select id="up-subject" class="admin-input" required>
                        <option value="Physics">Physics</option>
                        <option value="Chemistry">Chemistry</option>
                        <option value="Mathematics">Mathematics</option>
                        <option value="Biology">Biology</option>
                        <option value="Inorganic Chemistry">Inorganic Chemistry</option>
                        <option value="Organic Chemistry">Organic Chemistry</option>
                        <option value="Full Syllabus">Full Syllabus / General</option>
                    </select>
                </div>

                <!-- Integrated Material Link Type Dropper -->
                <div>
                    <label class="block text-xs text-textMuted mb-1 ml-1">Link Integration Target</label>
                    <select id="up-link-type" onchange="toggleFormInputs()" class="admin-input" required>
                        <option value="pdf">Standard Document / PDF Link</option>
                        <option value="youtube">YouTube Video Embed Stream</option>
                        <option value="zoom">Zoom Live Stream Meeting</option>
                    </select>
                </div>
                
                <div>
                    <label class="block text-xs text-textMuted mb-1 ml-1">Topic Title / Name</label>
                    <input type="text" id="up-topic" placeholder="e.g. Rotational Dynamics L-2" class="admin-input" required>
                </div>
                
                <div>
                    <label class="block text-xs text-textMuted mb-1 ml-1" id="link-label">Resource Link (PDF Link or Code)</label>
                    <input type="text" id="up-code" placeholder="Resource link URL..." class="admin-input" required>
                </div>

                <!-- Zoom Secondary Information Panel (Dynamic) -->
                <div id="zoom-fields" class="hidden grid grid-cols-2 gap-3 bg-[#0d0e15] p-3 rounded-2xl border border-gray-800">
                    <div>
                        <label class="block text-xs text-textMuted mb-1 ml-1">Meeting ID</label>
                        <input type="text" id="up-zoom-id" placeholder="845 2332 9494" class="admin-input">
                    </div>
                    <div>
                        <label class="block text-xs text-textMuted mb-1 ml-1">Passcode</label>
                        <input type="text" id="up-zoom-pass" placeholder="123456" class="admin-input">
                    </div>
                </div>

                <div>
                    <label class="block text-xs text-textMuted mb-1 ml-1">Display Metadata (e.g., File size or Duration)</label>
                    <input type="text" id="up-size" placeholder="e.g. 1.8 MB or 90 Mins" class="admin-input">
                </div>

                <!-- NEW: Backdating override for Timeline feature -->
                <div>
                    <label class="block text-xs text-textMuted mb-1 ml-1">Timeline Target Date (Optional)</label>
                    <input type="date" id="up-date" class="admin-input text-textMuted" title="Leave blank to use today's date for timeline sorting">
                </div>

                <button type="submit" id="btn-submit" class="w-full mt-4 bg-appPink hover:bg-appPinkDark text-white font-bold py-3.5 rounded-xl transition-all shadow-lg flex items-center justify-center gap-2">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Save Asset
                </button>
            </form>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="modal-delete" class="hidden absolute inset-0 z-[60] flex items-center justify-center bg-black/80 backdrop-blur-sm px-5">
        <div class="bg-appCard w-full max-w-sm rounded-3xl p-6 text-center border border-gray-800 shadow-2xl fade-in">
            <div class="w-16 h-16 bg-red-500/10 rounded-full flex items-center justify-center mx-auto mb-4 text-red-500 text-2xl">
                <i class="fa-solid fa-trash"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Delete Item?</h3>
            <p class="text-textMuted text-sm mb-6">This item will be instantly removed from the Student app.</p>
            <div class="flex gap-3">
                <button onclick="closeDeleteModal()" class="flex-1 py-3 bg-gray-800 rounded-xl text-white font-medium">Cancel</button>
                <button id="btn-confirm-del" class="flex-1 py-3 bg-red-500 rounded-xl text-white font-medium shadow-lg shadow-red-500/20">Delete</button>
            </div>
        </div>
    </div>

    <!-- Toast Banner -->
    <div id="toast" class="absolute top-4 left-1/2 -translate-x-1/2 z-[100] px-4 py-2.5 rounded-full bg-appCard border border-gray-700 shadow-2xl text-sm font-medium text-white flex items-center gap-2 transition-all duration-300 opacity-0 pointer-events-none translate-y-[-20px]">
        <i class="fa-solid fa-circle-check text-appPink" id="toast-icon"></i>
        <span id="toast-msg">Success</span>
    </div>

    <script>
        // --- 1. FIREBASE SETUP ---
        const firebaseConfig = {
            apiKey: "AIzaSyCpG-jibUuhZbqzqHCDR7PeSOddxoNF4sg",
            authDomain: "studiment-tracking.firebaseapp.com",
            databaseURL: "https://studiment-tracking-default-rtdb.firebaseio.com",
            projectId: "studiment-tracking"
        };
        
        if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
        const db = firebase.database();
        const refMaterials = db.ref('study_text_entries');

        // --- 2. GLOBAL STATE ---
        let allData = [];
        let filteredData = [];
        let pendingDeleteId = null;

        const categoryLabels = {
            "notes": "Notes", "live": "Live Class", "tests": "Mock Test", 
            "pyq": "PYQ Bank", "practice": "Practice", "formula": "Formula", 
            "mindmaps": "Mind Map", "dpps": "DPP"
        };

        // --- 3. FETCH AND STATISTICS ENGINE ---
        refMaterials.on('value', snap => {
            const data = snap.val() || {};
            allData = Object.keys(data).map(key => ({ id: key, ...data[key] }));
            allData.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));
            
            calculateStats();
            filterAndSearchData();
        });

        const calculateStats = () => {
            document.getElementById('stat-total').innerText = allData.length;
            document.getElementById('stat-zoom').innerText = allData.filter(d => d.linkType === 'zoom').length;
            document.getElementById('stat-youtube').innerText = allData.filter(d => d.linkType === 'youtube').length;
            document.getElementById('stat-pdf').innerText = allData.filter(d => d.linkType === 'pdf' || !d.linkType).length;
        };

        // --- DYNAMIC FORM PANEL CONTROLLER ---
        const toggleFormInputs = () => {
            const targetType = document.getElementById('up-link-type').value;
            const zoomFields = document.getElementById('zoom-fields');
            const linkLabel = document.getElementById('link-label');
            const linkInput = document.getElementById('up-code');

            if (targetType === 'zoom') {
                zoomFields.classList.remove('hidden');
                linkLabel.innerText = 'Zoom Meeting Launch Link';
                linkInput.placeholder = 'https://zoom.us/j/84523329494...';
            } else if (targetType === 'youtube') {
                zoomFields.classList.add('hidden');
                linkLabel.innerText = 'YouTube Video URL (Share or Browser Link)';
                linkInput.placeholder = 'https://www.youtube.com/watch?v=...';
            } else {
                zoomFields.classList.add('hidden');
                linkLabel.innerText = 'Resource Link (PDF Link or Code)';
                linkInput.placeholder = 'PDF url or BrightClass code';
            }
        };

        // --- 4. MULTI-LEVEL REAL-TIME FILTERING ---
        const filterAndSearchData = () => {
            const searchVal = document.getElementById('admin-search').value.toLowerCase().trim();
            const catVal = document.getElementById('filter-category').value;
            const typeVal = document.getElementById('filter-type').value;

            filteredData = allData.filter(item => {
                const matchesSearch = item.topic ? item.topic.toLowerCase().includes(searchVal) : false;
                const matchesCategory = (catVal === 'all') || (item.category === catVal);
                
                // Link type normalizer
                const normalizedType = item.linkType || 'pdf';
                const matchesType = (typeVal === 'all') || (normalizedType === typeVal);
                
                return matchesSearch && matchesCategory && matchesType;
            });

            renderAdminList();
        };

        // --- 5. COMPONENT RENDERER ---
        const renderAdminList = () => {
            const container = document.getElementById('admin-list');
            if (filteredData.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-16 text-textMuted bg-appCard border border-gray-800/80 rounded-2xl">
                        <i class="fa-solid fa-magnifying-glass-chart text-4xl mb-3 text-gray-700"></i>
                        <p class="font-semibold text-white">No matching resources</p>
                        <p class="text-xs mt-1 text-textMuted">Adjust your filters or add a new material.</p>
                    </div>`;
                return;
            }

            container.innerHTML = filteredData.map(item => {
                const badge = getLinkTypeBadge(item.linkType);
                const timelineDate = item.timestamp ? new Date(item.timestamp).toLocaleDateString('en-CA') : 'N/A';
                
                return `
                <div class="bg-appCard border border-gray-800/80 rounded-2xl p-4 flex flex-col md:flex-row gap-4 justify-between items-start md:items-center hover:border-gray-700 transition-colors">
                    <div class="flex-1 min-w-0">
                        <div class="flex flex-wrap items-center gap-2 mb-2">
                            <span class="text-[9px] uppercase tracking-wider font-extrabold text-white bg-appPink px-2.5 py-1 rounded-md shadow-sm shadow-appPink/10">${categoryLabels[item.category] || 'Notes'}</span>
                            <span class="text-[10px] text-gray-400 bg-gray-800/80 border border-gray-800 px-2 py-0.5 rounded-md font-medium">${escapeHtml(item.subject)}</span>
                            ${badge}
                            ${item.size ? `<span class="text-[10px] text-textMuted"><i class="fa-solid fa-circle-info text-[8px] mr-1"></i>${escapeHtml(item.size)}</span>` : ''}
                        </div>
                        <h4 class="text-sm font-bold text-white truncate max-w-sm md:max-w-md">${escapeHtml(item.topic)}</h4>
                        <div class="text-[10px] text-textMuted mt-1.5 flex gap-3 truncate max-w-xs md:max-w-md">
                            <span class="bg-[#090a10] px-2 py-1 rounded border border-gray-800/40 font-mono truncate">Target: ${escapeHtml(item.code)}</span>
                            <span class="bg-[#090a10] px-2 py-1 rounded border border-gray-800/40 text-appPink"><i class="fa-regular fa-calendar mr-1"></i> ${timelineDate}</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 self-stretch md:self-auto pt-2 md:pt-0 border-t border-gray-800/40 md:border-none">
                        <button onclick="testLink('${item.id}')" title="Test Link / Stream" class="flex-1 md:flex-none h-10 px-3.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded-xl transition-all text-xs font-bold flex items-center justify-center gap-1.5 border border-gray-700">
                            <i class="fa-solid fa-arrow-up-right-from-square"></i> Preview
                        </button>
                        <button onclick="openEditModal('${item.id}')" title="Edit Properties" class="w-10 h-10 bg-indigo-500/10 hover:bg-indigo-500 text-indigo-400 hover:text-white rounded-xl transition-all flex items-center justify-center border border-indigo-500/20">
                            <i class="fa-solid fa-pencil text-sm"></i>
                        </button>
                        <button onclick="confirmDelete('${item.id}')" title="Remove Asset" class="w-10 h-10 bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white rounded-xl transition-all flex items-center justify-center border border-red-500/20">
                            <i class="fa-solid fa-trash-can text-sm"></i>
                        </button>
                    </div>
                </div>
            `}).join('');
        };

        const getLinkTypeBadge = (linkType) => {
            switch(linkType) {
                case 'zoom':
                    return `<span class="text-[9px] uppercase tracking-wider font-extrabold text-blue-400 bg-blue-500/10 border border-blue-500/20 px-2 py-0.5 rounded">Zoom Meeting</span>`;
                case 'youtube':
                    return `<span class="text-[9px] uppercase tracking-wider font-extrabold text-red-500 bg-red-500/10 border border-red-500/20 px-2 py-0.5 rounded">YouTube Embed</span>`;
                case 'pdf':
                default:
                    return `<span class="text-[9px] uppercase tracking-wider font-extrabold text-sky-400 bg-sky-500/10 border border-sky-500/20 px-2 py-0.5 rounded">PDF Doc</span>`;
            }
        };

        // --- 6. FORM DISPATCH ENGINE ---
        const openEditModal = (id) => {
            const item = allData.find(d => d.id === id);
            if (!item) return;

            document.getElementById('modal-title').innerText = "Edit Asset Properties";
            document.getElementById('edit-id').value = item.id;
            document.getElementById('up-category').value = item.category || 'notes';
            document.getElementById('up-subject').value = item.subject || 'Physics';
            document.getElementById('up-link-type').value = item.linkType || 'pdf';
            document.getElementById('up-topic').value = item.topic || '';
            document.getElementById('up-code').value = item.code || '';
            document.getElementById('up-size').value = item.size || '';
            
            // Zoom secondary fields mapping
            document.getElementById('up-zoom-id').value = item.meetingId || '';
            document.getElementById('up-zoom-pass').value = item.passcode || '';

            // Handle Timeline Date Extraction
            if(item.timestamp) {
                const itemDate = new Date(item.timestamp);
                const localDateStr = `${itemDate.getFullYear()}-${String(itemDate.getMonth()+1).padStart(2,'0')}-${String(itemDate.getDate()).padStart(2,'0')}`;
                document.getElementById('up-date').value = localDateStr;
            } else {
                document.getElementById('up-date').value = '';
            }

            toggleFormInputs();
            document.getElementById('btn-submit').innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Update Changes';
            openUploadModal();
        };

        const testLink = (id) => {
            const item = allData.find(d => d.id === id);
            if (!item) return;
            const code = item.code;

            if (item.linkType === 'youtube') {
                let regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
                let match = code.match(regExp);
                if (match && match[2].length === 11) {
                    window.open(`https://www.youtube.com/embed/${match[2]}`, '_blank');
                } else {
                    window.open(code, '_blank');
                }
                return;
            }

            if (code.startsWith('http')) {
                window.open(code, '_blank');
                return;
            }

            showToast("Resolving brightclass proxy...");
            const proxyUrl = `https://api.allorigins.win/raw?url=${encodeURIComponent('https://server.brightclass.com/api/v1/file-storage/link-by-filecode?fileCode='+code)}`;
            fetch(proxyUrl).then(res => res.json()).then(data => {
                if (data && data.cdnUrl) window.open(data.cdnUrl, '_blank');
                else showToast("Code could not resolve", true);
            }).catch(() => showToast("Proxy request failed", true));
        };

        // --- 7. MODERATION LOGICS ---
        const openUploadModal = () => {
            document.getElementById('modal-upload').classList.remove('hidden');
        };
        
        const closeUploadModal = () => {
            document.getElementById('modal-upload').classList.add('hidden');
            document.getElementById('upload-form').reset();
            document.getElementById('edit-id').value = "";
            document.getElementById('modal-title').innerText = "Upload Asset";
            document.getElementById('btn-submit').innerHTML = '<i class="fa-solid fa-cloud-arrow-up"></i> Save Asset';
            toggleFormInputs();
        };

        const handleUpload = async (e) => {
            e.preventDefault();
            const editId = document.getElementById('edit-id').value;
            const category = document.getElementById('up-category').value;
            const subject = document.getElementById('up-subject').value;
            const linkType = document.getElementById('up-link-type').value;
            const topic = document.getElementById('up-topic').value.trim();
            const code = document.getElementById('up-code').value.trim();
            const size = document.getElementById('up-size').value.trim();
            
            // Timeline processing
            const customDateInput = document.getElementById('up-date').value;
            let targetTimestamp = Date.now();
            if (customDateInput) {
                // Creates date at midnight local time for the selected day
                const [year, month, day] = customDateInput.split('-');
                targetTimestamp = new Date(year, month - 1, day, 12, 0, 0).getTime();
            }

            // Zoom payload values
            const meetingId = document.getElementById('up-zoom-id').value.trim();
            const passcode = document.getElementById('up-zoom-pass').value.trim();

            const btn = document.getElementById('btn-submit');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Storing Transaction...';
            btn.disabled = true;

            const payload = {
                category, subject, linkType, topic, code, size,
                meetingId: linkType === 'zoom' ? meetingId : null,
                passcode: linkType === 'zoom' ? passcode : null,
            };

            try {
                if (editId) {
                    payload.timestamp = targetTimestamp; // Apply custom or existing date
                    payload.lastModified = Date.now();
                    await refMaterials.child(editId).update(payload);
                    showToast("Asset properties updated");
                } else {
                    payload.timestamp = targetTimestamp;
                    await refMaterials.push(payload);
                    showToast("Asset saved to live repository");
                }
                closeUploadModal();
            } catch(err) {
                showToast("Live transaction aborted", true);
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        };

        // --- 8. REMOVAL LOGIC ---
        const confirmDelete = (id) => {
            pendingDeleteId = id;
            document.getElementById('modal-delete').classList.remove('hidden');
        };
        const closeDeleteModal = () => {
            pendingDeleteId = null;
            document.getElementById('modal-delete').classList.add('hidden');
        };
        
        document.getElementById('btn-confirm-del').addEventListener('click', async () => {
            if(!pendingDeleteId) return;
            try {
                await refMaterials.child(pendingDeleteId).remove();
                showToast("Asset deleted permanently");
            } catch(e) {
                showToast("Aborted deletion", true);
            }
            closeDeleteModal();
        });

        // --- 9. UTILITIES ---
        const escapeHtml = (str) => {
            if (!str) return '';
            return str.replace(/[&<>]/g, m => ({'&': '&amp;', '<': '&lt;', '>': '&gt;'}[m]));
        };

        const showToast = (msg, isError = false) => {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = msg;
            const icon = document.getElementById('toast-icon');
            icon.className = isError ? 'fa-solid fa-circle-exclamation text-red-500' : 'fa-solid fa-circle-check text-appPink';

            toast.style.opacity = '1';
            toast.style.transform = 'translate(-50%, 0)';
            
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translate(-50%, -20px)';
            }, 2500);
        };
    </script>
</body>
</html>
